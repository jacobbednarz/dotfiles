{
  "$schema" : "https:\/\/schema.linearmouse.app\/0.11.2",
  "schemes" : [
    {
      "buttons" : {
        "clickDebouncing" : {
          "timeout" : 0
        }
      },
      "if" : {
        "device" : {
          "category" : "mouse",
          "productID" : "0xc52b",
          "productName" : "USB Receiver",
          "vendorID" : "0x46d"
        }
      },
      "pointer" : {
        "acceleration" : "unset",
        "disableAcceleration" : false,
        "redirectsToScroll" : false,
        "speed" : 0.1079
      },
      "scrolling" : {
        "acceleration" : 1,
        "distance" : {
          "horizontal" : 4,
          "vertical" : 2
        },
        "modifiers" : {
          "horizontal" : {
            "shift" : {
              "type" : "auto"
            }
          }
        },
        "reverse" : false,
        "smoothed" : {
          "enabled" : false
        },
        "speed" : 0
      }
    },
    {
      "if" : {
        "app" : "com.google.Chrome",
        "device" : {
          "category" : "mouse",
          "productID" : "0xc52b",
          "productName" : "USB Receiver",
          "vendorID" : "0x46d"
        }
      },
      "scrolling" : {
        "reverse" : {
          "horizontal" : true
        }
      }
    }
  ]
}